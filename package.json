{
  "name": "fell-runner",
  "version": "0.2.0",
  "description": "A Celeste-style speedrunning platformer over three notorious Lake District fells, with real routes, seeded weather, wind physics, ghosts and full accessibility. Free to play in your browser.",
  "keywords": [
    "game",
    "browser-game",
    "platformer",
    "speedrun",
    "celeste-like",
    "pixel-art",
    "html5-canvas",
    "javascript",
    "accessibility",
    "a11y",
    "lake-district",
    "fell-running",
    "seeded-random",
    "github-pages",
    "zero-dependencies"
  ],
  "homepage": "https://rmcrkd.github.io/fell-runner/",
  "repository": {
    "type": "git",
    "url": "https://github.com/rmcrkd/fell-runner.git"
  },
  "bugs": {
    "url": "https://github.com/rmcrkd/fell-runner/issues"
  },
  "author": "Ryan McCrickerd",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node tools/serve.js",
    "test": "node --test tests/*.test.js",
    "test:quick": "node --test $(ls tests/*.test.js | grep -v /route-)",
    "par": "node tools/par.js",
    "metadata": "node tools/metadata.js check",
    "metadata:sync": "node tools/metadata.js sync",
    "links": "node tools/links.js"
  },
  "engines": {
    "node": ">=22"
  }
}
